--- /dev/null
+++ b/cmapi/tests/service/test_review_r87_c5.py
@@ -0,0 +1,25 @@
+from test_flow import NS, OLA, auth
+from test_review_d_delivery import run_until, status
+from test_github_check_runs import poll, CONTEXT_CMAPI, CONTEXT_KUBECONFORM, CONTEXT_KYVERNO
+
+
+class LegacyProvider:
+    """A structural provider implementing the old operations without the newly added optional flag."""
+    def __init__(self, delegate):
+        self.delegate = delegate
+
+    def __getattr__(self, name):
+        if name == "external_ci":
+            raise AttributeError(name)
+        return getattr(self.delegate, name)
+
+
+def test_provider_without_new_capability_keeps_posting_legacy_contexts(world):
+    client, ctx, fake, kube, validator, keys = world
+    rid = client.post("/api/v1/clusters/CRC/namespaces", json=NS, headers=auth(keys, "ola", **OLA)).json()["requestId"]
+    assert run_until(ctx, "pr_checks") == "pr_checks"
+    ctx.git = LegacyProvider(fake)
+    poll(ctx)
+    assert status(client, keys, rid)["status"] == "merged"
+    head = next(iter(fake.statuses))
+    assert set(fake.statuses[head]) == {CONTEXT_CMAPI, CONTEXT_KUBECONFORM, CONTEXT_KYVERNO}
