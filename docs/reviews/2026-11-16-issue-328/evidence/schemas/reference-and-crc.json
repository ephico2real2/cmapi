{
  "create.label": {
    "type": "object",
    "properties": {
      "cmapi.net/team": {
        "type": "string",
        "description": "Ownership and cost; any team, not checked against the caller",
        "pattern": "^(?:^[a-z0-9-]{2,40}$)$",
        "maxLength": 63,
        "minLength": 1,
        "examples": [
          "payments"
        ]
      },
      "cmapi.net/cost-center": {
        "type": "string",
        "pattern": "^(?:^cc-[0-9]{4}$)$",
        "maxLength": 63,
        "examples": [
          "cc-4410"
        ]
      },
      "cmapi.net/app": {
        "type": "string",
        "description": "Links an app's environments",
        "pattern": "^(?:^[a-z0-9-]{2,40}$)$",
        "maxLength": 63
      },
      "cmapi.net/rightsizing": {
        "type": "string",
        "description": "Opt-in to automatic rnd and qa decreases",
        "pattern": "^(?:^(auto|manual)$)$",
        "maxLength": 63
      },
      "cmapi.net/protected": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9](?:[-A-Za-z0-9_.]*[A-Za-z0-9])?)?$",
