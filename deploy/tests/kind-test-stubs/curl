#!/usr/bin/env bash
# The CNPG download is the real, already verified file; the port-forwarded answers are the scenario's.
out=""; prev=""; for a in "$@"; do [ "$prev" = -o ] && out=$a; prev=$a; done
case " $* " in
  *cnpg-1.30.1.yaml*) cp "$KT_CNPG" "$out";;
  *readyz*) [ -z "${KT_READY_RC:-}" ] || exit "$KT_READY_RC"; [ -z "$out" ] || echo '{"status":"ok"}' >"$out"; printf '%s' "${KT_READY:-200}";;
  # The front door, on its own port-forward: its health, the API through it, and the mockup only on the mockup's host.
  *127.0.0.1:18081/healthz*) printf '%s' "${KT_FRONT_HEALTH:-200}";;
  *127.0.0.1:18081/api/v1/version*) printf '%s' "${KT_FRONT_VERSION-{\"version\":\"0.2.0\",\"commit\":\"abcdef1234\",\"component\":\"api\"\}}";;
  *api/v1/version*) printf '%s' "${KT_VERSION-{\"version\":\"0.2.0\",\"commit\":\"abcdef1234\",\"component\":\"api\"\}}";;
  *"Host: cmapi-mockup.kind.invalid"*portal.html*) printf '%s' "${KT_MOCK:-200}";;
  *portal.html*) printf 404;;
esac
