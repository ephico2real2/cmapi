# cmapi: one image, three entry points (cmapi-api, cmapi-worker, cmapi-capacity) plus cmapi-migrate.
# UBI9 python-312-minimal with kubeconform and the Kyverno CLI baked in (docs/01, Deployment topology),
# and Swagger UI and ReDoc bundled so /docs works where no CDN is reachable.
#
# Every download is pinned by version and SHA-256; a mismatch fails the build. The base image is
# pinned by digest. Runs as the base image's non-root user (1001, group 0) and fits the restricted SCC.

# The Kyverno that the clusters run (the owner's decision on #213): v1.20.0, published 2026-11-12, pinned to the exact patch;
# a later patch is a reviewed bump. Global, because two stages use it: the tools stage downloads it and the final stage
# sets CMAPI_KYVERNO_VERSION from it. An ARG's default does not cross stages; each stage that uses a global ARG declares it
# again without a value (Dockerfile reference, "Scope" and "Understand how ARG and FROM interact"; #388).
ARG KYVERNO_VERSION=v1.20.0

FROM registry.access.redhat.com/ubi9/python-312-minimal@sha256:b99faaadaf10de740d60c713a047088df2f46ebdd766e9c6a0957896f44d0ea1 AS tools

# The SHA-256 is the release's checksums.txt for kyverno-cli_v1.20.0_linux_x86_64.tar.gz.
ARG KYVERNO_VERSION
ARG KYVERNO_SHA256=06b8f3ca7b5626473be8fb4d343ad54ab84e317142766f72420e7d44b80942e2
ARG KUBECONFORM_VERSION=v0.6.7
ARG KUBECONFORM_SHA256=95f14e87aa28c09d5941f11bd024c1d02fdc0303ccaa23f61cef67bc92619d73
# kubeconform's schemas, by commit and SHA-256: without them every plan depends on raw.githubusercontent.com
ARG SCHEMAS_COMMIT=86d045595d3f93b703bbf439cf9eb4bd6830d58f
ARG SCHEMAS_KUBERNETES=v1.33.0
ARG SWAGGER_UI_VERSION=5.34.1
ARG SWAGGER_UI_SHA256=8e7286de0230e431fc8a5a75490d28117af3d0c306413b6f9e17f7bb55045fb6
ARG REDOC_VERSION=3.1.0
ARG REDOC_SHA256=d6f4b0c0abb970724c112473ace8229fd1cc3c78be4ca110841de4c640de15a9

USER 0
WORKDIR /tmp/tools
# tar and gzip are only needed to unpack the downloads; this stage is discarded
RUN microdnf install -y tar gzip >/dev/null && microdnf clean all
RUN set -eu; \
    curl -sSfL --retry 5 -o kyverno.tgz "https://github.com/kyverno/kyverno/releases/download/${KYVERNO_VERSION}/kyverno-cli_${KYVERNO_VERSION}_linux_x86_64.tar.gz"; \
    echo "${KYVERNO_SHA256}  kyverno.tgz" | sha256sum -c -; \
    curl -sSfL --retry 5 -o kubeconform.tgz "https://github.com/yannh/kubeconform/releases/download/${KUBECONFORM_VERSION}/kubeconform-linux-amd64.tar.gz"; \
    echo "${KUBECONFORM_SHA256}  kubeconform.tgz" | sha256sum -c -; \
    curl -sSfL --retry 5 -o swagger.tgz "https://registry.npmjs.org/swagger-ui-dist/-/swagger-ui-dist-${SWAGGER_UI_VERSION}.tgz"; \
    echo "${SWAGGER_UI_SHA256}  swagger.tgz" | sha256sum -c -; \
    curl -sSfL --retry 5 -o redoc.tgz "https://registry.npmjs.org/redoc/-/redoc-${REDOC_VERSION}.tgz"; \
    echo "${REDOC_SHA256}  redoc.tgz" | sha256sum -c -; \
    mkdir -p bin static/swagger-ui static/redoc schemas; \
    for pair in \
      namespace-v1:324fae677b98d1a6d54340db0c334d053e8ffbafceb3f73326e41de2610d5843 \
      resourcequota-v1:9546ed313e622ea84a0ab1ec7ef7e683f05acfbfe97beb746f0b5be6407691df \
      limitrange-v1:de9bfabf9ea0bff36b71e5e686d3ecce5246b098061f39a70549f82f8f03acd7 \
      serviceaccount-v1:8193d6c3561475c6d3d5c44e1faedb1df53905373d904bc17015694326d659cf \
      rolebinding-rbac-v1:87ab620d0adddcd2803b92357fce2854af752326df8c5408a7588aae98b3031d; do \
      name=${pair%%:*}; \
      curl -sSfL --retry 5 -o "schemas/${name}.json" "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/${SCHEMAS_COMMIT}/${SCHEMAS_KUBERNETES}-standalone-strict/${name}.json"; \
      echo "${pair##*:}  schemas/${name}.json" | sha256sum -c -; \
    done; \
    tar xzf kyverno.tgz -C bin kyverno; \
    tar xzf kubeconform.tgz -C bin kubeconform; \
    tar xzf swagger.tgz -C static/swagger-ui --strip-components=1 package/swagger-ui-bundle.js package/swagger-ui.css package/favicon-32x32.png; \
    tar xzf redoc.tgz -C static/redoc --strip-components=2 package/bundles/redoc.standalone.js; \
    chmod 0755 bin/kyverno bin/kubeconform

FROM registry.access.redhat.com/ubi9/python-312-minimal@sha256:b99faaadaf10de740d60c713a047088df2f46ebdd766e9c6a0957896f44d0ea1

ARG GIT_COMMIT=unknown
ARG BUILD_VERSION=0.0.0
# The global default above (#388)
ARG KYVERNO_VERSION
LABEL org.opencontainers.image.title="cmapi" \
      org.opencontainers.image.source="https://github.com/ephico2real2/cmapi" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.version="${BUILD_VERSION}"

# The commit is served by GET /api/v1/version and checked by the release script in the running pod. The Kyverno version
# is reported by GET /api/v1/admin/integrations: the least version that the clusters must run (docs/11).
ENV CMAPI_GIT_COMMIT=${GIT_COMMIT} \
    CMAPI_KYVERNO_VERSION=${KYVERNO_VERSION} \
    CMAPI_STATIC_DIR=/opt/app-root/static \
    CMAPI_KUBECONFORM_SCHEMAS="/opt/app-root/schemas/{{ .ResourceKind }}{{ .KindSuffix }}.json" \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/opt/app-root/src

USER 0
# The Git layer (#286) runs the git CLI and OpenSSH: Red Hat's signed UBI packages, updated with RHEL errata, not a PyPI library.
# nss_wrapper-libs gives ssh a passwd entry under a UID that has none, outside CRI-O; /etc/passwd stays 0644 (CRI-O adds the
# pod's UID only to a file that group and others cannot write). Measured: git-core 2.52.0, openssh-clients 9.9p1, 61.9 MB.
RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 git-core openssh-clients nss_wrapper-libs >/dev/null && \
    microdnf clean all && git --version && ssh -V && test -e /usr/lib64/libnss_wrapper.so && \
    test "$(stat -c %a /etc/passwd)" = 644
COPY --from=tools /tmp/tools/bin/kyverno /tmp/tools/bin/kubeconform /usr/local/bin/
COPY --from=tools /tmp/tools/static /opt/app-root/static
COPY --from=tools /tmp/tools/schemas /opt/app-root/schemas
WORKDIR /opt/app-root/src
# Every Python package comes from the hashed lock (#655): exact versions, each file checked against its SHA-256, wheels only,
# so nothing floats at build time and a changed file fails the build. The lock holds pip too, which replaces the base image's
# pip 24.2 (#657), and the build backend. cmapi itself then goes in with --no-deps and that backend, the pattern of pip's
# "Secure installs" (https://pip.pypa.io/en/stable/topics/secure-installs/). pip check fails the build when the lock no longer
# satisfies pyproject.toml (cmapi/lock.sh regenerates it). The backend is not needed at run time and leaves the image.
COPY requirements.txt ./
RUN pip install --no-cache-dir --require-hashes --no-deps --only-binary :all: -r requirements.txt
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps --no-build-isolation --no-index . && \
    pip check && pip uninstall --yes setuptools && \
    rm -rf src build *.egg-info requirements.txt && \
    mkdir -p /etc/cmapi/config /etc/cmapi/policies /opt/app-root/src/.kube && \
    chown -R 1001:0 /opt/app-root && chmod -R g=u /opt/app-root
COPY policies /etc/cmapi/policies
# MUTANT (#650 proof, reverted next): one bundle that its owner and group 0 cannot read
RUN chmod 0600 /opt/app-root/static/redoc/redoc.standalone.js

# OpenShift runs the image as an arbitrary UID that owns no file, is in group 0 and has no capabilities ("Support arbitrary
# user ids", the OpenShift image guidelines). chmod -R g=u gives group 0 the owner's bits, so a file its owner cannot read stays
# unreadable, and a COPY after it keeps the modes of the build context. Such a file under /static passes StaticFiles' os.stat,
# and Starlette 1.10.0 sends 200 before it opens the file (responses.py:427-433): the client gets a cut body (#650). So the
# build runs as such a user and fails on a path it cannot read, a directory it cannot search, or a file that its owner may run
# and it cannot. The canary first proves the check sees modes: a user with CAP_DAC_OVERRIDE reads a file of mode 000, and the
# check would pass anything.
USER 1000690000:0
RUN set -eu; \
    canary=$(mktemp); chmod 000 "$canary"; \
    if [ -r "$canary" ]; then echo "the modes check cannot see modes: this user reads a file of mode 000" >&2; exit 1; fi; \
    rm -f "$canary"; \
    paths="/opt/app-root /etc/cmapi /usr/local/bin"; \
    bad=$( { find $paths ! -type l -exec sh -c 'for p; do [ -r "$p" ] || echo "cannot read $p"; done' sh {} +; \
             find $paths \( -type d -o -type f -perm -100 \) -exec sh -c 'for p; do [ -x "$p" ] || echo "cannot search or run $p"; done' sh {} +; \
           } 2>&1 ) || true; \
    if [ -n "$bad" ]; then printf 'Not usable by an arbitrary UID in group 0 (#650):\n%s\n' "$bad" >&2; exit 1; fi; \
    echo "image modes (#650): an arbitrary UID in group 0 reads every file and searches every directory under $paths"

USER 1001
EXPOSE 8080 9090
ENTRYPOINT ["cmapi-api"]
